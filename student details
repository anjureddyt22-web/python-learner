

def student_result(m1,m2,m3,m4,m5):
    marks=[m1,m2,m3,m4,m5]
    total=sum(marks)
    avg=total/5
    print("average=",avg)
    print("higest=",max(marks))
    print("lowest=",min(marks))
    if avg>=40:
        print("pass")
    else:
        print("fail")
